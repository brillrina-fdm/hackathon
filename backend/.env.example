# Optional base root. Used when route-specific dirs are not set.
LOCAL_AGENT_INBOX_DIR=./local-agent-inbox

# Optional route-specific inboxes.
# If omitted, defaults are:
# - <LOCAL_AGENT_INBOX_DIR>/content
# - <LOCAL_AGENT_INBOX_DIR>/context
LOCAL_AGENT_CONTENT_INBOX_DIR=./local-agent-inbox/content
LOCAL_AGENT_CONTEXT_INBOX_DIR=./local-agent-inbox/context
